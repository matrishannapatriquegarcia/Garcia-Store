@model IEnumerable<Garcia_Midterm_Store.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";

    decimal total = 0;

    foreach (var item in Model)
    {
        if (item.Product != null)
        {
            total += item.Product.Price * item.Quantity;
        }
    }
}

<div class="container mt-4">

    <!-- page header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>Shopping Cart</h1>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-outline-primary">
            ← Continue Shopping
        </a>

    </div>


    @if (!Model.Any())
    {
        <!-- empty cart -->
        <div class="alert alert-info text-center">
            <h4>Your cart is empty.</h4>

            <p class="mb-3">
                Add some products to your cart first.
            </p>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-primary">
                View Products
            </a>
        </div>
    }
    else
    {
        <!-- cart table -->
        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>Product Name</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Subtotal</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- PRODUCT NAME -->
                                    <td>
                                        <strong>
                                            @item.Product?.Name
                                        </strong>
                                    </td>


                                    <!-- PRICE -->
                                    <td>
                                        ₱@(item.Product?.Price.ToString("N2") ?? "0.00")
                                    </td>


                                    <!-- QUANTITY -->
                                    <td>

                                        <form asp-action="UpdateQuantity"
                                              method="post"
                                              class="d-flex">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <input type="number"
                                                   name="quantity"
                                                   value="@item.Quantity"
                                                   min="1"
                                                   class="form-control me-2"
                                                   style="width: 90px;" />

                                            <button type="submit"
                                                    class="btn btn-primary">
                                                Update
                                            </button>

                                        </form>

                                    </td>


                                    <!-- SUBTOTAL -->
                                    <td>
                                        ₱@(((item.Product?.Price ?? 0) * item.Quantity).ToString("N2"))
                                    </td>


                                    <!-- REMOVE -->
                                    <td>

                                        <form asp-action="Remove"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger">
                                                Remove
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- TOTAL -->
                <div class="d-flex justify-content-end mt-4">

                    <div class="text-end">

                        <h4>
                            Total Amount
                        </h4>

                        <h2 class="fw-bold">
                            ₱@total.ToString("N2")
                        </h2>

                    </div>

                </div>

            </div>

        </div>
    }

</div>